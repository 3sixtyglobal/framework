{
	"name": "@twin.org/context",
	"version": "0.0.3-next.22",
	"description": "Helper methods/classes for context handling",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/framework.git",
		"directory": "packages/context"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run test:build && npm run docs"
	},
	"dependencies": {
		"@twin.org/core": "0.0.3-next.22",
		"@twin.org/nameof": "0.0.3-next.22"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "0.0.3-next.22",
		"@twin.org/nameof-vitest-plugin": "0.0.3-next.22",
		"@twin.org/validate-locales": "0.0.3-next.22",
		"@types/node": "25.3.3",
		"@vitest/coverage-v8": "4.0.18",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"nodemon": "3.1.14",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"context",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/framework/issues"
	},
	"homepage": "https://twindev.org"
}
