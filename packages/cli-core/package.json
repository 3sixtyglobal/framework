{
	"name": "@twin.org/cli-core",
	"version": "0.10.1-next.8",
	"description": "Core classes for building a CLI",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-framework.git",
		"directory": "packages/cli-core"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"merge-locales": "copyfiles locales/en.json dist",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "pnpm dlx @twin.org/validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,merge,types,test \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,merge,types \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@twin.org/core": "0.10.1-next.8",
		"@twin.org/nameof": "0.10.1-next.8",
		"chalk": "6.0.0",
		"commander": "15.0.0",
		"dotenv": "18.0.1"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "0.10.1-next.8",
		"@twin.org/nameof-vitest-plugin": "0.10.1-next.8",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"copyfiles": "2.4.1",
		"concurrently": "10.0.5",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"core",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-framework/issues"
	},
	"homepage": "https://twindev.org"
}
