{
	"name": "@twin.org/cli-core",
	"version": "0.0.3-next.43",
	"description": "Core classes for building a CLI",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/framework.git",
		"directory": "packages/cli-core"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"merge-locales": "copyfiles locales/en.json dist",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "npx @twin.org/validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales"
	},
	"dependencies": {
		"@twin.org/core": "0.0.3-next.43",
		"@twin.org/nameof": "0.0.3-next.43",
		"chalk": "5.6.2",
		"commander": "14.0.3",
		"dotenv": "17.4.2"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "0.0.3-next.43",
		"@twin.org/nameof-vitest-plugin": "0.0.3-next.43",
		"@types/node": "25.6.2",
		"@vitest/coverage-v8": "4.1.5",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"nodemon": "3.1.14",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.5"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"core",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/framework/issues"
	},
	"homepage": "https://twindev.org"
}
