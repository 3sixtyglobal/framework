{
	"name": "@3sixty/cli-core",
	"version": "0.20.0-next.2",
	"description": "Core classes for building a CLI",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/framework.git",
		"directory": "packages/cli-core"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage .cache",
		"build": "tstransform",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"merge-locales": "copyfiles locales/en.json dist",
		"test": "vitest --run --config ./vitest.config.ts",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts",
		"test:build": "tstransform -p ./tests/tsconfig.json",
		"validate-locales": "tsx ../../apps/validate-locales/src/cli-dev.ts",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && pnpm run merge-locales && concurrently -g -n build,types,test \"pnpm run build\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && pnpm run merge-locales && concurrently -g -n build,types \"pnpm run build\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/core": "0.20.0-next.2",
		"@3sixty/nameof": "0.20.0-next.2",
		"chalk": "6.0.1",
		"commander": "15.0.0",
		"dotenv": "18.0.8"
	},
	"devDependencies": {
		"@3sixty/nameof-transformer": "0.20.0-next.2",
		"@3sixty/nameof-vitest-plugin": "0.20.0-next.2",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"tsx": "4.23.15",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"core",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/framework/issues"
	},
	"homepage": "https://3sixty.global"
}
