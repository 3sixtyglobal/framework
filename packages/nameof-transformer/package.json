{
	"name": "@twin.org/nameof-transformer",
	"version": "0.9.3-next.3",
	"description": "Typed transformer which converts types and properties to their actual name for use at runtime",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-framework.git",
		"directory": "packages/nameof-transformer"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tsc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "echo Can not perform locale validation on nameof-transformer package as the validate-locales package depends on nameof-transformer",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-framework/issues"
	},
	"homepage": "https://twindev.org"
}
