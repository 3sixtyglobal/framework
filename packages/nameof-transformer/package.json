{
	"name": "@3sixty/nameof-transformer",
	"version": "0.20.0-next.6",
	"description": "Typed transformer which converts types and properties to their actual name for use at runtime",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/framework.git",
		"directory": "packages/nameof-transformer"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.4"
	},
	"scripts": {
		"clean": "rimraf dist coverage .cache",
		"build": "tsc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts",
		"test:bun": "bunx --bun vitest --run --config ./vitest.config.ts",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "echo Can not perform locale validation on nameof-transformer package as the validate-locales package depends on nameof-transformer",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"typescript": "6.0.3",
		"typescript-native": "npm:typescript@7.1.0-beta"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1",
		"vitest": "5.0.5"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"tstransform": "bin/tstransform.js"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/framework/issues"
	},
	"homepage": "https://3sixty.global"
}
