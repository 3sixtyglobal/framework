{
	"name": "@twin.org/nameof",
	"version": "0.0.3-next.3",
	"description": "Provides the definitions for the methods which are processed by the nameof-transformer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/framework.git",
		"directory": "packages/nameof"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "echo Can not perform locale validation on nameof package as the validate-locales package depends on nameof",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run test:build && npm run docs"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "0.0.3-next.3",
		"@vitest/coverage-v8": "4.0.8",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.10",
		"rimraf": "6.1.0",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.14",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "4.0.8"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/framework/issues"
	},
	"homepage": "https://twindev.org"
}
