{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"3sixtyglobal",
		"AARRGGBB",
		"abbrev",
		"apng",
		"ARGB",
		"autorelease",
		"Bech",
		"bitcode",
		"cbor",
		"CEFACT",
		"chacha",
		"crit",
		"Dataspace",
		"decryptor",
		"encryptor",
		"Firestore",
		"GTSC",
		"Hmac",
		"hotfixes",
		"Hotp",
		"htac",
		"htdc",
		"iotaledger",
		"IPFS",
		"JFIF",
		"jsonld",
		"nameof",
		"ODRL",
		"officedocument",
		"openxmlformats",
		"otpauth",
		"paeth",
		"Plte",
		"prehash",
		"presentationml",
		"Priv",
		"Quant",
		"quicktime",
		"RGBYUV",
		"RRGGBB",
		"scanline",
		"Secp",
		"selectordinal",
		"spreadsheetml",
		"Stiftung",
		"teardown",
		"TLIP",
		"Totp",
		"tspc",
		"ttsc",
		"ttypescript",
		"UNECE",
		"unuse",
		"UVQT",
		"wordprocessingml",
		"workerd"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/<code\\b[^>]*>[\\s\\S]*?<\\/code>/g",
		"/<M\\b[^>]*>[\\s\\S]*?<\\/M>/g",
		"/`[^`\\r\\n]+`/g"
	],
	"ignoreWords": ["noopener", "noreferrer", "pingback"]
}
