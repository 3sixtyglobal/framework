{
	"name": "@twin.org/merge-locales",
	"version": "0.0.4-next.6",
	"description": "Merge locale files from all dependencies",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-framework.git",
		"directory": "apps/merge-locales"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"merge-locales": "copyfiles locales/en.json dist && node bin/index.js",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "echo Can not perform locale validation on merge-locales package as the validate-locales package depends on merge-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales"
	},
	"dependencies": {
		"@twin.org/cli-core": "0.0.4-next.6",
		"@twin.org/core": "0.0.4-next.6",
		"@twin.org/nameof": "0.0.4-next.6",
		"commander": "14.0.3",
		"glob": "13.0.6"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "0.0.4-next.6",
		"@twin.org/nameof-vitest-plugin": "0.0.4-next.6",
		"@types/node": "25.9.0",
		"@vitest/coverage-v8": "4.1.6",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.6"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"merge-locales": "bin/index.js"
	},
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-framework/issues"
	},
	"homepage": "https://twindev.org",
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain"
	]
}
