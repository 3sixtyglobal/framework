{
	"name": "@twin.org/validate-locales",
	"version": "0.0.3-next.26",
	"description": "Validate source files against the locales",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/framework.git",
		"directory": "apps/validate-locales"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "node bin/index.js",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales"
	},
	"dependencies": {
		"@twin.org/cli-core": "0.0.3-next.26",
		"@twin.org/core": "0.0.3-next.26",
		"@twin.org/nameof": "0.0.3-next.26",
		"@twin.org/nameof-transformer": "0.0.3-next.26",
		"commander": "14.0.3",
		"glob": "13.0.6",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@twin.org/merge-locales": "0.0.3-next.26",
		"@twin.org/nameof-vitest-plugin": "0.0.3-next.26",
		"@types/node": "25.5.0",
		"@vitest/coverage-v8": "4.1.1",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.18",
		"typedoc-plugin-markdown": "4.11.0",
		"vitest": "4.1.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"validate-locales": "bin/index.js"
	},
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"bugs": {
		"url": "git+https://github.com/twinfoundation/framework/issues"
	},
	"homepage": "https://twindev.org",
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain"
	]
}
